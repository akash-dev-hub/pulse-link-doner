rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 24 && u.matches('^[a-z0-9_]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'akshuboi123@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedUser()
          && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin');
    }

    function isDonorCapableAfter(uid) {
      return !existsAfter(/databases/$(database)/documents/user_roles/$(uid))
        || getAfter(/databases/$(database)/documents/user_roles/$(uid)).data.role in ['donor', 'admin'];
    }

    function isHospitalRoleAfter(uid) {
      return isBootstrapAdmin()
        || (existsAfter(/databases/$(database)/documents/user_roles/$(uid))
          && getAfter(/databases/$(database)/documents/user_roles/$(uid)).data.role in ['hospital', 'admin']);
    }

    function isHospitalRoleCurrent(uid) {
      return isBootstrapAdmin()
        || (exists(/databases/$(database)/documents/user_roles/$(uid))
          && get(/databases/$(database)/documents/user_roles/$(uid)).data.role in ['hospital', 'admin']);
    }

    function isApprovedHospital(uid) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/hospitals/$(uid))
        && get(/databases/$(database)/documents/hospitals/$(uid)).data.status == 'approved';
    }

    function isRequesterCapable(uid) {
      return isBootstrapAdmin()
        || !exists(/databases/$(database)/documents/user_roles/$(uid))
        || get(/databases/$(database)/documents/user_roles/$(uid)).data.role in ['donor', 'requester', 'admin']
        || (get(/databases/$(database)/documents/user_roles/$(uid)).data.role == 'hospital'
          && exists(/databases/$(database)/documents/hospitals/$(uid))
          && get(/databases/$(database)/documents/hospitals/$(uid)).data.status == 'approved');
    }

    function isValidBloodGroup(bg) {
      return bg in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function isValidUrgency(u) {
      return u is string && u in ['critical', 'urgent', 'planned'];
    }

    function isValidOptionalCoord(val, minVal, maxVal) {
      return val == null || ((val is int || val is float) && val >= minVal && val <= maxVal);
    }

    function isValidRoleName(role) {
      return role is string && role in ['donor', 'requester', 'hospital', 'admin'];
    }

    function isValidInventoryUnit(val) {
      return val is int && val >= 0 && val <= 100000;
    }

    function isValidInventory(inv) {
      return inv is map
        && inv.keys().hasAll(['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'])
        && inv.keys().hasOnly(['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'])
        && isValidInventoryUnit(inv['A+'])
        && isValidInventoryUnit(inv['A-'])
        && isValidInventoryUnit(inv['B+'])
        && isValidInventoryUnit(inv['B-'])
        && isValidInventoryUnit(inv['AB+'])
        && isValidInventoryUnit(inv['AB-'])
        && isValidInventoryUnit(inv['O+'])
        && isValidInventoryUnit(inv['O-']);
    }

    function isValidUsernameReservation(data, usernameLower) {
      return data.keys().hasAll(['uid', 'username', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'createdAt', 'updatedAt'])
        && data.uid is string && isValidId(data.uid) && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && data.username == usernameLower
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDonorPublic(data, donorId) {
      return data.keys().hasAll([
        'uid', 'username', 'bloodGroup', 'countryCode', 'countryName',
        'stateCode', 'stateName', 'city', 'locality', 'pincode',
        'visibleInSearch', 'eligibleAfterMs', 'searchActiveAfterMs',
        'contactPreference', 'approxLat', 'approxLng', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'username', 'bloodGroup', 'countryCode', 'countryName',
        'stateCode', 'stateName', 'city', 'locality', 'pincode',
        'visibleInSearch', 'eligibleAfterMs', 'searchActiveAfterMs',
        'contactPreference', 'approxLat', 'approxLng', 'createdAt', 'updatedAt',
        'lastCompletedRequestId'
      ])
      && data.uid is string && data.uid == donorId
      && isValidUsername(data.username)
      && isValidBloodGroup(data.bloodGroup)
      && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
      && data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 100
      && data.stateCode is string && data.stateCode.size() <= 16
      && data.stateName is string && data.stateName.size() <= 100
      && data.city is string && data.city.size() >= 1 && data.city.size() <= 100
      && data.locality is string && data.locality.size() <= 120
      && data.pincode is string && data.pincode.size() <= 16
      && data.visibleInSearch is bool
      && (data.eligibleAfterMs is int || data.eligibleAfterMs is float) && data.eligibleAfterMs >= 0
      && (data.searchActiveAfterMs is int || data.searchActiveAfterMs is float) && data.searchActiveAfterMs >= 0
      && data.contactPreference is string && data.contactPreference in ['chat', 'hidden']
      && (
        (data.visibleInSearch == true
          && data.eligibleAfterMs < 9000000000000
          && data.searchActiveAfterMs == data.eligibleAfterMs
          && data.contactPreference == 'chat')
        ||
        (data.visibleInSearch == false
          && data.searchActiveAfterMs == 9999999999999
          && data.contactPreference == 'hidden')
      )
      && isValidOptionalCoord(data.approxLat, -90, 90)
      && isValidOptionalCoord(data.approxLng, -180, 180)
      && (!('lastCompletedRequestId' in data) || isValidId(data.lastCompletedRequestId))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidDonorPrivate(data, donorId) {
      return data.keys().hasAll([
        'uid', 'fullName', 'phone', 'email', 'contactPreference', 'lastDonationDate',
        'exactLat', 'exactLng', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'fullName', 'phone', 'email', 'contactPreference', 'lastDonationDate',
        'exactLat', 'exactLng', 'createdAt', 'updatedAt',
        'lastCompletedRequestId'
      ])
      && data.uid is string && data.uid == donorId
      && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
      && data.phone is string && data.phone.size() <= 30
      && data.email is string && data.email.size() <= 150
      && data.contactPreference is string && data.contactPreference == 'chat'
      && data.lastDonationDate is string && data.lastDonationDate.size() <= 10
      && (data.lastDonationDate == '' || data.lastDonationDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
      && isValidOptionalCoord(data.exactLat, -90, 90)
      && isValidOptionalCoord(data.exactLng, -180, 180)
      && (!('lastCompletedRequestId' in data) || isValidId(data.lastCompletedRequestId))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidNewEmergencyRequest(data) {
      return data.keys().hasAll([
        'createdBy', 'createdByName', 'hospitalId', 'hospitalName', 'bloodGroup',
        'units', 'unitsCompleted', 'urgency', 'confirmedUrgency',
        'countryCode', 'countryName', 'stateCode', 'stateName', 'city',
        'locality', 'pincode', 'hospitalLat', 'hospitalLng',
        'notes', 'status', 'hospitalVerifiedAt', 'donorsNotifiedAt', 'notifiedDonorCount',
        'createdAt', 'updatedAt', 'fulfilledAt', 'cancelledAt', 'cancelledBy'
      ])
      && data.keys().hasOnly([
        'createdBy', 'createdByName', 'hospitalId', 'hospitalName', 'bloodGroup',
        'units', 'unitsCompleted', 'urgency', 'confirmedUrgency',
        'countryCode', 'countryName', 'stateCode', 'stateName', 'city',
        'locality', 'pincode', 'hospitalLat', 'hospitalLng',
        'notes', 'status', 'hospitalVerifiedAt', 'donorsNotifiedAt', 'notifiedDonorCount',
        'createdAt', 'updatedAt', 'fulfilledAt', 'cancelledAt', 'cancelledBy'
      ])
      && !('contact' in data)
      && data.createdBy is string && isValidId(data.createdBy)
      && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 100
      && data.hospitalId is string && isValidId(data.hospitalId)
      && data.hospitalName is string && data.hospitalName.size() >= 2 && data.hospitalName.size() <= 120
      && isValidBloodGroup(data.bloodGroup)
      && data.units is int && data.units >= 1 && data.units <= 100
      && data.unitsCompleted is int && data.unitsCompleted >= 0 && data.unitsCompleted <= data.units
      && isValidUrgency(data.urgency)
      && (data.confirmedUrgency == null || isValidUrgency(data.confirmedUrgency))
      && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
      && data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 100
      && data.stateCode is string && data.stateCode.size() <= 16
      && data.stateName is string && data.stateName.size() <= 100
      && data.city is string && data.city.size() >= 1 && data.city.size() <= 100
      && data.locality is string && data.locality.size() <= 120
      && data.pincode is string && data.pincode.size() <= 16
      && isValidOptionalCoord(data.hospitalLat, -90, 90)
      && isValidOptionalCoord(data.hospitalLng, -180, 180)
      && data.notes is string && data.notes.size() <= 300
      && data.status is string && data.status in [
        'submitted', 'hospital_verified', 'donors_notified',
        'donor_accepted', 'donor_verified', 'contacts_shared',
        'donation_completed', 'cancelled'
      ]
      && (data.hospitalVerifiedAt == null || data.hospitalVerifiedAt is timestamp)
      && (data.donorsNotifiedAt == null || data.donorsNotifiedAt is timestamp)
      && data.notifiedDonorCount is int && data.notifiedDonorCount >= 0 && data.notifiedDonorCount <= 10000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && (data.fulfilledAt == null || data.fulfilledAt is timestamp)
      && (data.cancelledAt == null || data.cancelledAt is timestamp)
      && data.cancelledBy is string && data.cancelledBy.size() <= 128;
    }

    function isValidLegacyEmergencyRequest(data) {
      return data.keys().hasAll([
        'createdBy', 'createdByName', 'bloodGroup', 'units', 'hospitalName',
        'countryCode', 'countryName', 'stateCode', 'stateName', 'city',
        'locality', 'pincode', 'hospitalLat', 'hospitalLng', 'contact',
        'notes', 'status', 'createdAt', 'updatedAt', 'fulfilledAt'
      ])
      && data.keys().hasOnly([
        'createdBy', 'createdByName', 'bloodGroup', 'units', 'hospitalName',
        'countryCode', 'countryName', 'stateCode', 'stateName', 'city',
        'locality', 'pincode', 'hospitalLat', 'hospitalLng', 'contact',
        'notes', 'status', 'createdAt', 'updatedAt', 'fulfilledAt'
      ])
      && data.createdBy is string && isValidId(data.createdBy)
      && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 100
      && isValidBloodGroup(data.bloodGroup)
      && data.units is int && data.units >= 1 && data.units <= 100
      && data.hospitalName is string && data.hospitalName.size() >= 2 && data.hospitalName.size() <= 120
      && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
      && data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 100
      && data.stateCode is string && data.stateCode.size() <= 16
      && data.stateName is string && data.stateName.size() <= 100
      && data.city is string && data.city.size() >= 1 && data.city.size() <= 100
      && data.locality is string && data.locality.size() <= 120
      && data.pincode is string && data.pincode.size() <= 16
      && isValidOptionalCoord(data.hospitalLat, -90, 90)
      && isValidOptionalCoord(data.hospitalLng, -180, 180)
      && data.contact is string && data.contact.size() >= 3 && data.contact.size() <= 150
      && data.notes is string && data.notes.size() <= 300
      && data.status is string && data.status in ['active', 'fulfilled']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && (data.fulfilledAt == null || data.fulfilledAt is timestamp);
    }

    function isValidRequestPrivateContact(data, reqId) {
      return data.keys().hasAll([
        'requestId', 'requesterUid', 'hospitalId', 'requesterContact', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'requestId', 'requesterUid', 'hospitalId', 'requesterContact', 'createdAt', 'updatedAt'
      ])
      && data.requestId is string && data.requestId == reqId && isValidId(data.requestId)
      && data.requesterUid is string && isValidId(data.requesterUid)
      && data.hospitalId is string && isValidId(data.hospitalId)
      && data.requesterContact is string && data.requesterContact.size() >= 3 && data.requesterContact.size() <= 150
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidRequestResponse(data, responseId) {
      return data.keys().hasAll([
        'requestId', 'requesterUid', 'hospitalId', 'donorUid', 'donorUsername',
        'bloodGroup', 'status', 'decisionNote',
        'verifiedBy', 'verifiedAt', 'contactsSharedAt',
        'completedBy', 'completedAt', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'requestId', 'requesterUid', 'hospitalId', 'donorUid', 'donorUsername',
        'bloodGroup', 'status', 'decisionNote',
        'verifiedBy', 'verifiedAt', 'contactsSharedAt',
        'completedBy', 'completedAt', 'createdAt', 'updatedAt'
      ])
      && data.requestId is string && isValidId(data.requestId)
      && data.requesterUid is string && isValidId(data.requesterUid)
      && data.hospitalId is string && isValidId(data.hospitalId)
      && data.donorUid is string && isValidId(data.donorUid)
      && responseId == data.requestId + '__' + data.donorUid
      && isValidUsername(data.donorUsername)
      && isValidBloodGroup(data.bloodGroup)
      && data.status is string && data.status in [
        'donor_accepted', 'donor_declined', 'donor_verified',
        'contacts_shared', 'donation_completed', 'cancelled'
      ]
      && data.decisionNote is string && data.decisionNote.size() <= 300
      && data.verifiedBy is string && data.verifiedBy.size() <= 128
      && (data.verifiedAt == null || data.verifiedAt is timestamp)
      && (data.contactsSharedAt == null || data.contactsSharedAt is timestamp)
      && data.completedBy is string && data.completedBy.size() <= 128
      && (data.completedAt == null || data.completedAt is timestamp)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidRequestDonorContact(data, responseId) {
      return data.keys().hasAll([
        'requestId', 'donorUid', 'hospitalId', 'donorContact', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'requestId', 'donorUid', 'hospitalId', 'donorContact', 'createdAt', 'updatedAt'
      ])
      && data.requestId is string && isValidId(data.requestId)
      && data.donorUid is string && isValidId(data.donorUid)
      && data.hospitalId is string && isValidId(data.hospitalId)
      && responseId == data.requestId + '__' + data.donorUid
      && data.donorContact is string && data.donorContact.size() >= 3 && data.donorContact.size() <= 150
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidRequestSharedContact(data, responseId) {
      return data.keys().hasAll([
        'requestId', 'requesterUid', 'donorUid', 'hospitalId',
        'requesterUsername', 'donorUsername', 'requesterContact', 'donorContact',
        'sharedBy', 'sharedAt', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'requestId', 'requesterUid', 'donorUid', 'hospitalId',
        'requesterUsername', 'donorUsername', 'requesterContact', 'donorContact',
        'sharedBy', 'sharedAt', 'createdAt', 'updatedAt'
      ])
      && data.requestId is string && isValidId(data.requestId)
      && data.requesterUid is string && isValidId(data.requesterUid)
      && data.donorUid is string && isValidId(data.donorUid)
      && data.hospitalId is string && isValidId(data.hospitalId)
      && responseId == data.requestId + '__' + data.donorUid
      && isValidUsername(data.requesterUsername)
      && isValidUsername(data.donorUsername)
      && data.requesterContact is string && data.requesterContact.size() >= 3 && data.requesterContact.size() <= 150
      && data.donorContact is string && data.donorContact.size() >= 3 && data.donorContact.size() <= 150
      && data.sharedBy is string && isValidId(data.sharedBy)
      && data.sharedAt is timestamp
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
        'recipientId', 'senderId', 'requestId', 'bloodGroup', 'units', 'urgency',
        'hospitalName', 'city', 'locality', 'stateName', 'countryName',
        'hospitalLat', 'hospitalLng', 'sameLocality', 'read', 'createdAt'
      ])
      && data.keys().hasOnly([
        'recipientId', 'senderId', 'requestId', 'bloodGroup', 'units', 'urgency',
        'hospitalName', 'city', 'locality', 'stateName', 'countryName',
        'hospitalLat', 'hospitalLng', 'sameLocality', 'read', 'createdAt'
      ])
      && !('contact' in data)
      && data.recipientId is string && isValidId(data.recipientId)
      && data.senderId is string && isValidId(data.senderId)
      && data.requestId is string && isValidId(data.requestId)
      && isValidBloodGroup(data.bloodGroup)
      && data.units is int && data.units >= 1 && data.units <= 100
      && isValidUrgency(data.urgency)
      && data.hospitalName is string && data.hospitalName.size() >= 2 && data.hospitalName.size() <= 120
      && data.city is string && data.city.size() >= 1 && data.city.size() <= 100
      && data.locality is string && data.locality.size() <= 120
      && data.stateName is string && data.stateName.size() <= 100
      && data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 100
      && isValidOptionalCoord(data.hospitalLat, -90, 90)
      && isValidOptionalCoord(data.hospitalLng, -180, 180)
      && data.sameLocality is bool
      && data.read is bool
      && data.createdAt is timestamp;
    }

    function isValidChat(data, chatId) {
      return data.keys().hasAll([
        'participantIds', 'p1Uid', 'p2Uid', 'p1Username', 'p2Username',
        'p1Unread', 'p2Unread', 'blockedByP1', 'blockedByP2',
        'lastMessageText', 'lastMessageSenderId', 'lastMessageAt',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'participantIds', 'p1Uid', 'p2Uid', 'p1Username', 'p2Username',
        'p1Unread', 'p2Unread', 'blockedByP1', 'blockedByP2',
        'lastMessageText', 'lastMessageSenderId', 'lastMessageAt',
        'createdAt', 'updatedAt'
      ])
      && data.p1Uid is string && isValidId(data.p1Uid)
      && data.p2Uid is string && isValidId(data.p2Uid)
      && data.p1Uid < data.p2Uid
      && chatId == data.p1Uid + '__' + data.p2Uid
      && data.participantIds is list && data.participantIds.size() == 2
      && data.participantIds[0] is string && data.participantIds[0] == data.p1Uid
      && data.participantIds[1] is string && data.participantIds[1] == data.p2Uid
      && isValidUsername(data.p1Username)
      && isValidUsername(data.p2Username)
      && data.p1Unread is int && data.p1Unread >= 0 && data.p1Unread <= 100000
      && data.p2Unread is int && data.p2Unread >= 0 && data.p2Unread <= 100000
      && data.blockedByP1 is bool
      && data.blockedByP2 is bool
      && data.lastMessageText is string && data.lastMessageText.size() <= 1000
      && data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128
      && (data.lastMessageAt == null || data.lastMessageAt is timestamp)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, chatId) {
      return data.keys().hasAll([
        'chatId', 'participantIds', 'senderId', 'senderUsername', 'text', 'createdAt'
      ])
      && data.keys().hasOnly([
        'chatId', 'participantIds', 'senderId', 'senderUsername', 'text', 'createdAt'
      ])
      && data.chatId is string && data.chatId == chatId
      && data.participantIds is list && data.participantIds.size() == 2
      && data.participantIds[0] is string && isValidId(data.participantIds[0])
      && data.participantIds[1] is string && isValidId(data.participantIds[1])
      && data.senderId is string && isValidId(data.senderId) && data.senderId == request.auth.uid
      && isValidUsername(data.senderUsername)
      && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
      && data.createdAt is timestamp;
    }

    function isValidUserRole(data, userId) {
      return data.keys().hasAll([
        'uid', 'email', 'username', 'role', 'assignedBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'username', 'role', 'assignedBy', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == userId
      && data.email is string && data.email.size() <= 150
      && data.username is string && data.username.size() <= 24
      && isValidRoleName(data.role)
      && data.assignedBy is string && isValidId(data.assignedBy)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidHospital(data, hospitalId) {
      return data.keys().hasAll([
        'uid', 'ownerUsername', 'name', 'facilityType', 'licenseNumber', 'contact',
        'countryCode', 'countryName', 'stateCode', 'stateName', 'city',
        'locality', 'pincode', 'lat', 'lng', 'status', 'reviewNote',
        'reviewedBy', 'reviewedAt', 'inventory', 'inventoryUpdatedAt',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'ownerUsername', 'name', 'facilityType', 'licenseNumber', 'contact',
        'countryCode', 'countryName', 'stateCode', 'stateName', 'city',
        'locality', 'pincode', 'lat', 'lng', 'status', 'reviewNote',
        'reviewedBy', 'reviewedAt', 'inventory', 'inventoryUpdatedAt',
        'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == hospitalId
      && isValidUsername(data.ownerUsername)
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
      && data.facilityType is string && data.facilityType in ['hospital', 'blood_bank']
      && data.licenseNumber is string && data.licenseNumber.size() <= 80
      && data.contact is string && data.contact.size() >= 3 && data.contact.size() <= 150
      && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
      && data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 100
      && data.stateCode is string && data.stateCode.size() <= 16
      && data.stateName is string && data.stateName.size() <= 100
      && data.city is string && data.city.size() >= 1 && data.city.size() <= 100
      && data.locality is string && data.locality.size() <= 120
      && data.pincode is string && data.pincode.size() <= 16
      && isValidOptionalCoord(data.lat, -90, 90)
      && isValidOptionalCoord(data.lng, -180, 180)
      && data.status is string && data.status in ['pending', 'approved', 'rejected']
      && data.reviewNote is string && data.reviewNote.size() <= 300
      && data.reviewedBy is string && data.reviewedBy.size() <= 128
      && (data.reviewedAt == null || data.reviewedAt is timestamp)
      && isValidInventory(data.inventory)
      && (data.inventoryUpdatedAt == null || data.inventoryUpdatedAt is timestamp)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /usernames/{usernameLower} {
      allow get: if isSignedIn() && isValidUsername(usernameLower);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidUsername(usernameLower)
        && isValidUsernameReservation(incoming(), usernameLower)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidUsername(usernameLower)
        && existing().uid == request.auth.uid;
    }

    match /users_public/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'updatedAt'])
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == request.auth.uid;

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
    }

    match /donors_public/{donorId} {
      allow get: if isSignedIn() && isValidId(donorId) && (
        isOwner(donorId)
        || isApprovedHospital(request.auth.uid)
        || (existing().visibleInSearch == true && existing().searchActiveAfterMs <= request.time.toMillis())
      );

      allow list: if isSignedIn()
        && existing().searchActiveAfterMs <= request.time.toMillis();

      allow create: if isVerifiedUser()
        && isValidId(donorId)
        && isOwner(donorId)
        && isDonorCapableAfter(donorId)
        && isValidDonorPublic(incoming(), donorId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(donorId)
        && isValidDonorPublic(incoming(), donorId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner updates their own public donor profile
          (isOwner(donorId)
            && isDonorCapableAfter(donorId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'bloodGroup', 'countryCode', 'countryName',
              'stateCode', 'stateName', 'city', 'locality', 'pincode',
              'visibleInSearch', 'eligibleAfterMs', 'searchActiveAfterMs',
              'contactPreference', 'approxLat', 'approxLng', 'updatedAt',
              'displayName', 'preferredContactType', 'preferredContactValue'
            ])
            && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username))
            && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == request.auth.uid)
          ||
          // Action 2: Assigned approved hospital marks a verified donation completed (updates 90-day eligibility)
          (isApprovedHospital(request.auth.uid)
            && 'lastCompletedRequestId' in incoming()
            && incoming().eligibleAfterMs >= request.time.toMillis()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'eligibleAfterMs', 'searchActiveAfterMs', 'lastCompletedRequestId', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId))
            && get(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.hospitalId == request.auth.uid
            && get(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.donorUid == donorId
            && get(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.status in ['donor_verified', 'contacts_shared']
            && getAfter(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.status == 'donation_completed'
            && getAfter(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.completedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.completedAt == request.time)
        );

      allow delete: if isVerifiedUser() && isValidId(donorId) && isOwner(donorId);
    }

    match /donors_private/{donorId} {
      allow get: if isSignedIn() && isValidId(donorId) && isOwner(donorId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(donorId)
        && isOwner(donorId)
        && isDonorCapableAfter(donorId)
        && isValidDonorPrivate(incoming(), donorId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(donorId)
        && isValidDonorPrivate(incoming(), donorId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner updates their own private donor details
          (isOwner(donorId)
            && isDonorCapableAfter(donorId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'phone', 'email', 'contactPreference', 'lastDonationDate',
              'exactLat', 'exactLng', 'updatedAt'
            ]))
          ||
          // Action 2: Assigned approved hospital updates donor's lastDonationDate upon completing donation
          (isApprovedHospital(request.auth.uid)
            && 'lastCompletedRequestId' in incoming()
            && incoming().lastDonationDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastDonationDate', 'lastCompletedRequestId', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId))
            && get(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.hospitalId == request.auth.uid
            && get(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.donorUid == donorId
            && get(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.status in ['donor_verified', 'contacts_shared']
            && getAfter(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.status == 'donation_completed'
            && getAfter(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.completedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/request_responses/$(incoming().lastCompletedRequestId + '__' + donorId)).data.completedAt == request.time)
        );

      allow delete: if isVerifiedUser() && isValidId(donorId) && isOwner(donorId);
    }

    match /emergency_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().status in [
          'hospital_verified', 'donors_notified', 'donor_accepted',
          'donor_verified', 'contacts_shared', 'active'
        ]
        || existing().createdBy == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );

      allow list: if isSignedIn() && (
        existing().status in [
          'hospital_verified', 'donors_notified', 'donor_accepted',
          'donor_verified', 'contacts_shared', 'active'
        ]
        || existing().createdBy == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isRequesterCapable(request.auth.uid)
        && isValidNewEmergencyRequest(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'submitted'
        && incoming().unitsCompleted == 0
        && incoming().confirmedUrgency == null
        && incoming().hospitalVerifiedAt == null
        && incoming().donorsNotifiedAt == null
        && incoming().notifiedDonorCount == 0
        && incoming().fulfilledAt == null
        && incoming().cancelledAt == null
        && incoming().cancelledBy == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/hospitals/$(incoming().hospitalId))
        && get(/databases/$(database)/documents/hospitals/$(incoming().hospitalId)).data.status == 'approved'
        && existsAfter(/databases/$(database)/documents/request_private_contacts/$(requestId))
        && getAfter(/databases/$(database)/documents/request_private_contacts/$(requestId)).data.requesterUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/request_private_contacts/$(requestId)).data.hospitalId == incoming().hospitalId;

      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && existing().status in [
          'submitted', 'hospital_verified', 'donors_notified',
          'donor_accepted', 'donor_verified', 'contacts_shared', 'active'
        ]
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Assigned approved hospital verifies submitted request, confirms urgency, and notifies donors
          (
            isValidNewEmergencyRequest(incoming())
            && isApprovedHospital(request.auth.uid)
            && existing().hospitalId == request.auth.uid
            && existing().status == 'submitted'
            && incoming().status in ['hospital_verified', 'donors_notified']
            && isValidUrgency(incoming().confirmedUrgency)
            && incoming().hospitalVerifiedAt == request.time
            && (
              (incoming().status == 'hospital_verified'
                && incoming().donorsNotifiedAt == null
                && incoming().notifiedDonorCount == 0)
              ||
              (incoming().status == 'donors_notified'
                && incoming().donorsNotifiedAt == request.time)
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'confirmedUrgency', 'hospitalVerifiedAt',
              'donorsNotifiedAt', 'notifiedDonorCount', 'updatedAt'
            ])
          )
          ||
          // Action 2: Assigned approved hospital transitions hospital_verified -> donors_notified or re-notifies
          (
            isValidNewEmergencyRequest(incoming())
            && isApprovedHospital(request.auth.uid)
            && existing().hospitalId == request.auth.uid
            && existing().status in [
              'hospital_verified', 'donors_notified', 'donor_accepted',
              'donor_verified', 'contacts_shared'
            ]
            && existing().hospitalVerifiedAt != null
            && incoming().status in ['donors_notified', existing().status]
            && incoming().donorsNotifiedAt == request.time
            && incoming().notifiedDonorCount >= existing().notifiedDonorCount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'donorsNotifiedAt', 'notifiedDonorCount', 'updatedAt'
            ])
          )
          ||
          // Action 3: Eligible donor accepts a notified request -> transitions donors_notified -> donor_accepted
          (
            isValidNewEmergencyRequest(incoming())
            && existing().status in ['hospital_verified', 'donors_notified']
            && incoming().status == 'donor_accepted'
            && request.auth.uid != existing().createdBy
            && request.auth.uid != existing().hospitalId
            && existsAfter(/databases/$(database)/documents/request_responses/$(requestId + '__' + request.auth.uid))
            && getAfter(/databases/$(database)/documents/request_responses/$(requestId + '__' + request.auth.uid)).data.status == 'donor_accepted'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Action 4: Assigned approved hospital verifies accepting donor & shares contacts
          (
            isValidNewEmergencyRequest(incoming())
            && isApprovedHospital(request.auth.uid)
            && existing().hospitalId == request.auth.uid
            && existing().status in ['donors_notified', 'donor_accepted', 'donor_verified', 'contacts_shared']
            && incoming().status in ['donor_verified', 'contacts_shared']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Action 5: Assigned approved hospital marks donation completed and closes once all units are met
          (
            isValidNewEmergencyRequest(incoming())
            && isApprovedHospital(request.auth.uid)
            && existing().hospitalId == request.auth.uid
            && existing().status in ['donors_notified', 'donor_accepted', 'donor_verified', 'contacts_shared']
            && incoming().unitsCompleted > existing().unitsCompleted
            && incoming().unitsCompleted <= existing().units
            && (
              (incoming().unitsCompleted >= existing().units
                && incoming().status == 'donation_completed'
                && incoming().fulfilledAt == request.time)
              ||
              (incoming().unitsCompleted < existing().units
                && incoming().status == existing().status
                && incoming().fulfilledAt == existing().fulfilledAt)
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'unitsCompleted', 'status', 'fulfilledAt', 'updatedAt'
            ])
          )
          ||
          // Action 6: Cancel request by creator or assigned hospital
          (
            isValidNewEmergencyRequest(incoming())
            && 'hospitalId' in existing()
            && (existing().createdBy == request.auth.uid || existing().hospitalId == request.auth.uid)
            && incoming().status == 'cancelled'
            && incoming().cancelledBy == request.auth.uid
            && incoming().cancelledAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'cancelledBy', 'cancelledAt', 'updatedAt'
            ])
          )
          ||
          // Action 7: Legacy active request fulfillment by creator
          (
            !('hospitalId' in existing())
            && existing().status == 'active'
            && existing().createdBy == request.auth.uid
            && isValidLegacyEmergencyRequest(incoming())
            && incoming().status == 'fulfilled'
            && incoming().fulfilledAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'fulfilledAt', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(requestId)
        && existing().createdBy == request.auth.uid
        && existing().status == 'submitted';
    }

    match /request_private_contacts/{requestId} {
      allow get: if isVerifiedUser() && isValidId(requestId) && (
        existing().requesterUid == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidRequestPrivateContact(incoming(), requestId)
        && incoming().requesterUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/emergency_requests/$(requestId))
        && getAfter(/databases/$(database)/documents/emergency_requests/$(requestId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/emergency_requests/$(requestId)).data.hospitalId == incoming().hospitalId;

      allow update, delete: if false;
    }

    match /request_responses/{responseId} {
      allow get: if isVerifiedUser() && isValidId(responseId) && (
        existing().donorUid == request.auth.uid
        || existing().requesterUid == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );

      allow list: if isVerifiedUser() && (
        existing().donorUid == request.auth.uid
        || existing().requesterUid == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(responseId)
        && isValidRequestResponse(incoming(), responseId)
        && incoming().donorUid == request.auth.uid
        && incoming().status in ['donor_accepted', 'donor_declined']
        && incoming().verifiedBy == ''
        && incoming().verifiedAt == null
        && incoming().contactsSharedAt == null
        && incoming().completedBy == ''
        && incoming().completedAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/emergency_requests/$(incoming().requestId))
        && get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.hospitalVerifiedAt != null
        && get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.status in [
          'hospital_verified', 'donors_notified', 'donor_accepted', 'donor_verified', 'contacts_shared'
        ]
        && get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.createdBy != request.auth.uid
        && get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.hospitalId != request.auth.uid
        && incoming().requesterUid == get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.createdBy
        && incoming().hospitalId == get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.hospitalId
        && incoming().bloodGroup == get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.bloodGroup
        && exists(/databases/$(database)/documents/donors_public/$(request.auth.uid))
        && get(/databases/$(database)/documents/donors_public/$(request.auth.uid)).data.visibleInSearch == true
        && get(/databases/$(database)/documents/donors_public/$(request.auth.uid)).data.searchActiveAfterMs <= request.time.toMillis()
        && get(/databases/$(database)/documents/donors_public/$(request.auth.uid)).data.bloodGroup == incoming().bloodGroup;

      allow update: if isVerifiedUser()
        && isValidId(responseId)
        && isValidRequestResponse(incoming(), responseId)
        && incoming().requestId == existing().requestId
        && incoming().requesterUid == existing().requesterUid
        && incoming().hospitalId == existing().hospitalId
        && incoming().donorUid == existing().donorUid
        && incoming().bloodGroup == existing().bloodGroup
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Donor switches between accepted and declined before hospital verification
          (existing().donorUid == request.auth.uid
            && existing().status in ['donor_accepted', 'donor_declined']
            && incoming().status in ['donor_accepted', 'donor_declined']
            && incoming().verifiedBy == ''
            && incoming().verifiedAt == null
            && incoming().contactsSharedAt == null
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'decisionNote', 'donorUsername', 'updatedAt'
            ]))
          ||
          // Action 2: Assigned approved hospital verifies accepting donor and shares contacts
          (isApprovedHospital(request.auth.uid)
            && existing().hospitalId == request.auth.uid
            && existing().status == 'donor_accepted'
            && incoming().status in ['donor_verified', 'contacts_shared']
            && incoming().verifiedBy == request.auth.uid
            && incoming().verifiedAt == request.time
            && incoming().contactsSharedAt == request.time
            && existsAfter(/databases/$(database)/documents/request_shared_contacts/$(responseId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'verifiedBy', 'verifiedAt', 'contactsSharedAt', 'updatedAt'
            ]))
          ||
          // Action 3: Assigned approved hospital marks donation completed
          (isApprovedHospital(request.auth.uid)
            && existing().hospitalId == request.auth.uid
            && existing().status in ['donor_verified', 'contacts_shared']
            && incoming().status == 'donation_completed'
            && incoming().completedBy == request.auth.uid
            && incoming().completedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'completedBy', 'completedAt', 'updatedAt'
            ]))
          ||
          // Action 4: Cancel response when request is cancelled by requester or assigned hospital
          ((existing().requesterUid == request.auth.uid || existing().hospitalId == request.auth.uid)
            && existing().status in ['donor_accepted', 'donor_verified', 'contacts_shared']
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if false;
    }

    match /request_donor_contacts/{responseId} {
      allow get: if isVerifiedUser() && isValidId(responseId) && (
        existing().donorUid == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(responseId)
        && isValidRequestDonorContact(incoming(), responseId)
        && incoming().donorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/request_responses/$(responseId))
        && getAfter(/databases/$(database)/documents/request_responses/$(responseId)).data.donorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/request_responses/$(responseId)).data.hospitalId == incoming().hospitalId;

      allow update: if isVerifiedUser()
        && isValidId(responseId)
        && isValidRequestDonorContact(incoming(), responseId)
        && existing().donorUid == request.auth.uid
        && incoming().requestId == existing().requestId
        && incoming().donorUid == existing().donorUid
        && incoming().hospitalId == existing().hospitalId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['donorContact', 'updatedAt']);

      allow delete: if false;
    }

    match /request_shared_contacts/{responseId} {
      allow get: if isVerifiedUser() && isValidId(responseId) && (
        existing().requesterUid == request.auth.uid
        || existing().donorUid == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );

      allow list: if isVerifiedUser() && (
        existing().requesterUid == request.auth.uid
        || existing().donorUid == request.auth.uid
        || existing().hospitalId == request.auth.uid
      );

      allow create: if isVerifiedUser()
        && isValidId(responseId)
        && isApprovedHospital(request.auth.uid)
        && isValidRequestSharedContact(incoming(), responseId)
        && incoming().hospitalId == request.auth.uid
        && incoming().sharedBy == request.auth.uid
        && incoming().sharedAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/emergency_requests/$(incoming().requestId))
        && get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.hospitalId == request.auth.uid
        && get(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.createdBy == incoming().requesterUid
        && existsAfter(/databases/$(database)/documents/request_responses/$(responseId))
        && getAfter(/databases/$(database)/documents/request_responses/$(responseId)).data.status in ['donor_verified', 'contacts_shared']
        && getAfter(/databases/$(database)/documents/request_responses/$(responseId)).data.verifiedBy == request.auth.uid;

      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && existing().recipientId == request.auth.uid;
      allow list: if isSignedIn() && existing().recipientId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && isApprovedHospital(request.auth.uid)
        && incoming().senderId == request.auth.uid
        && incoming().read == false
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/emergency_requests/$(incoming().requestId))
        && getAfter(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.hospitalId == request.auth.uid
        && getAfter(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.hospitalVerifiedAt != null
        && getAfter(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.status in [
          'hospital_verified', 'donors_notified', 'donor_accepted', 'donor_verified', 'contacts_shared'
        ]
        && incoming().bloodGroup == getAfter(/databases/$(database)/documents/emergency_requests/$(incoming().requestId)).data.bloodGroup
        && exists(/databases/$(database)/documents/donors_public/$(incoming().recipientId))
        && get(/databases/$(database)/documents/donors_public/$(incoming().recipientId)).data.visibleInSearch == true
        && get(/databases/$(database)/documents/donors_public/$(incoming().recipientId)).data.searchActiveAfterMs <= request.time.toMillis()
        && get(/databases/$(database)/documents/donors_public/$(incoming().recipientId)).data.bloodGroup == incoming().bloodGroup;

      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && existing().recipientId == request.auth.uid
        && incoming().recipientId == existing().recipientId
        && incoming().senderId == existing().senderId
        && incoming().requestId == existing().requestId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && incoming().read is bool;

      allow delete: if isVerifiedUser() && isValidId(notificationId) && existing().recipientId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get: if isVerifiedUser()
        && isValidId(chatId)
        && (
          (resource == null && (
            chatId.matches('^' + request.auth.uid + '__[a-zA-Z0-9_\\-]+$')
            || chatId.matches('^[a-zA-Z0-9_\\-]+__' + request.auth.uid + '$')
          ))
          || (resource != null && (existing().p1Uid == request.auth.uid || existing().p2Uid == request.auth.uid))
        );

      allow list: if isVerifiedUser()
        && request.auth.uid in existing().participantIds;

      allow create: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChat(incoming(), chatId)
        && (incoming().p1Uid == request.auth.uid || incoming().p2Uid == request.auth.uid)
        && incoming().blockedByP1 == false
        && incoming().blockedByP2 == false
        && incoming().p1Unread == 0
        && incoming().p2Unread == 0
        && incoming().lastMessageText == ''
        && incoming().lastMessageSenderId == ''
        && incoming().lastMessageAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChat(incoming(), chatId)
        && (existing().p1Uid == request.auth.uid || existing().p2Uid == request.auth.uid)
        && incoming().participantIds == existing().participantIds
        && incoming().p1Uid == existing().p1Uid
        && incoming().p2Uid == existing().p2Uid
        && incoming().createdAt == existing().createdAt
        && (
          (
            existing().blockedByP1 == false
            && existing().blockedByP2 == false
            && incoming().lastMessageSenderId == request.auth.uid
            && incoming().lastMessageText.size() >= 1
            && incoming().lastMessageAt == request.time
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt', 'p1Unread', 'p2Unread'
            ])
            && (
              (request.auth.uid == existing().p1Uid
                && incoming().p2Unread == existing().p2Unread + 1
                && incoming().p1Unread == 0)
              ||
              (request.auth.uid == existing().p2Uid
                && incoming().p1Unread == existing().p1Unread + 1
                && incoming().p2Unread == 0)
            )
          )
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['p1Unread'])
            && request.auth.uid == existing().p1Uid
            && incoming().p1Unread == 0
          )
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['p2Unread'])
            && request.auth.uid == existing().p2Uid
            && incoming().p2Unread == 0
          )
          ||
          (
            incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['blockedByP1', 'updatedAt'])
            && request.auth.uid == existing().p1Uid
          )
          ||
          (
            incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['blockedByP2', 'updatedAt'])
            && request.auth.uid == existing().p2Uid
          )
          ||
          (
            incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['p1Username', 'updatedAt'])
            && request.auth.uid == existing().p1Uid
          )
          ||
          (
            incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['p2Username', 'updatedAt'])
            && request.auth.uid == existing().p2Uid
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && request.auth.uid in existing().participantIds;

        allow list: if isVerifiedUser()
          && request.auth.uid in existing().participantIds;

        allow create: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidChatMessage(incoming(), chatId)
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && incoming().participantIds == get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && get(/databases/$(database)/documents/chats/$(chatId)).data.blockedByP1 == false
          && get(/databases/$(database)/documents/chats/$(chatId)).data.blockedByP2 == false
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageAt == request.time;

        allow update, delete: if false;
      }
    }

    function isValidPublicStats(data) {
      return data.keys().hasAll([
        'registeredDonors', 'activeRequests', 'fulfilledRequests', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'registeredDonors', 'activeRequests', 'fulfilledRequests', 'updatedAt'
      ])
      && data.registeredDonors is int && data.registeredDonors >= 0 && data.registeredDonors <= 1000000
      && data.activeRequests is int && data.activeRequests >= 0 && data.activeRequests <= 1000000
      && data.fulfilledRequests is int && data.fulfilledRequests >= 0 && data.fulfilledRequests <= 1000000
      && data.updatedAt is timestamp;
    }

    match /public_stats/{statId} {
      allow get: if isValidId(statId) && statId == 'summary';
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(statId)
        && statId == 'summary'
        && isValidPublicStats(incoming())
        && incoming().registeredDonors <= 1
        && incoming().activeRequests <= 1
        && incoming().fulfilledRequests <= 1
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(statId)
        && statId == 'summary'
        && isValidPublicStats(incoming())
        && incoming().registeredDonors >= existing().registeredDonors
        && incoming().registeredDonors <= existing().registeredDonors + 1
        && incoming().activeRequests >= existing().activeRequests - 1
        && incoming().activeRequests <= existing().activeRequests + 1
        && incoming().fulfilledRequests >= existing().fulfilledRequests
        && incoming().fulfilledRequests <= existing().fulfilledRequests + 1
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'registeredDonors', 'activeRequests', 'fulfilledRequests', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /user_roles/{userId} {
      allow get: if (isVerifiedUser() && isValidId(userId) && isOwner(userId)) || isAdmin();
      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserRole(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && incoming().role in ['donor', 'requester', 'hospital']
            && incoming().assignedBy == request.auth.uid)
          ||
          (isAdmin()
            && incoming().assignedBy == request.auth.uid)
        );

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserRole(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'role', 'email', 'username', 'assignedBy', 'updatedAt'
        ])
        && (
          (isOwner(userId)
            && existing().role != 'admin'
            && incoming().role in ['donor', 'requester', 'hospital']
            && incoming().assignedBy == request.auth.uid)
          ||
          (isAdmin()
            && incoming().assignedBy == request.auth.uid)
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /hospitals/{hospitalId} {
      allow get: if isSignedIn() && isValidId(hospitalId) && (
        existing().status == 'approved'
        || isOwner(hospitalId)
        || isAdmin()
      );

      allow list: if (isSignedIn() && existing().status == 'approved') || isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(hospitalId)
        && isOwner(hospitalId)
        && isHospitalRoleAfter(hospitalId)
        && isValidHospital(incoming(), hospitalId)
        && incoming().status == 'pending'
        && incoming().reviewedBy == ''
        && incoming().reviewedAt == null
        && incoming().reviewNote == ''
        && incoming().inventoryUpdatedAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(hospitalId)
        && isValidHospital(incoming(), hospitalId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin()
            && incoming().status in ['pending', 'approved', 'rejected']
            && incoming().reviewedBy == request.auth.uid
            && incoming().reviewedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'updatedAt'
            ]))
          ||
          (isOwner(hospitalId)
            && isHospitalRoleCurrent(hospitalId)
            && existing().status == 'approved'
            && incoming().status == existing().status
            && incoming().reviewedBy == existing().reviewedBy
            && incoming().reviewedAt == existing().reviewedAt
            && incoming().reviewNote == existing().reviewNote
            && incoming().inventoryUpdatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'inventory', 'inventoryUpdatedAt', 'updatedAt'
            ]))
          ||
          (isOwner(hospitalId)
            && isHospitalRoleCurrent(hospitalId)
            && incoming().status == existing().status
            && incoming().reviewedBy == existing().reviewedBy
            && incoming().reviewedAt == existing().reviewedAt
            && incoming().reviewNote == existing().reviewNote
            && incoming().inventory == existing().inventory
            && incoming().inventoryUpdatedAt == existing().inventoryUpdatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'facilityType', 'licenseNumber', 'contact',
              'countryCode', 'countryName', 'stateCode', 'stateName',
              'city', 'locality', 'pincode', 'lat', 'lng', 'ownerUsername', 'updatedAt'
            ]))
        );

      allow delete: if isAdmin() && isValidId(hospitalId);
    }
  }
}
