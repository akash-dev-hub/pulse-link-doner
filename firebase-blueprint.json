        "flagReasons",
        "expiresAt",
        "createdAt"
      ]
    },
    "SignupWindowCounter": {
      "title": "SignupWindowCounter",
      "description": "Opaque 24-hour keyed-hash counter tracking distinct signup hashes per device or IP without storing raw IPs or device IDs.",
      "type": "object",
      "properties": {
        "windowStartMs": { "type": "number" },
        "uidHashes": { "type": "array", "items": { "type": "string" } },
