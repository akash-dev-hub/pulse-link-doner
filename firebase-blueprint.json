        "deviceFlagged": { "type": "boolean" },
        "ipFlagged": { "type": "boolean" },
        "reportedFlagged": { "type": "boolean" },
        "flagReasons": { "type": "array", "items": { "type": "string" } },
        "deviceSignupCount24h": { "type": "integer", "minimum": 0 },
        "ipSignupCount24h": { "type": "integer", "minimum": 0 },
        "lastDeviceId": { "type": "string", "maxLength": 64 },
        "lastIpHash": { "type": "string", "maxLength": 64 },
        "reviewNote": { "type": "string", "maxLength": 300 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "flaggedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "username",
        "email",
        "status",
        "requiresAdminReview",
        "deviceFlagged",
        "ipFlagged",
        "reportedFlagged",
        "flagReasons",
        "deviceSignupCount24h",
        "ipSignupCount24h",
        "lastDeviceId",
        "lastIpHash",
        "reviewNote",
        "reviewedBy",
        "reviewedAt",
        "flaggedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserRateLimit": {
      "title": "UserRateLimit",
      "description": "Per-user atomic rate limit windows enforcing max 3 emergency requests per 24 hours and max 10 chat messages per minute.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reqWindowStart": { "type": ["string", "null"], "format": "date-time" },
        "reqCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "msgWindowStart": { "type": ["string", "null"], "format": "date-time" },
        "msgCount": { "type": "integer", "minimum": 0, "maximum": 10 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "reqWindowStart", "reqCount", "msgWindowStart", "msgCount", "updatedAt"]
    },
    "AbuseReport": {
      "title": "AbuseReport",
      "description": "User-submitted moderation report targeting a user, emergency request, or chat message.",
