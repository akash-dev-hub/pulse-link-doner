        "details": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["open", "approved_dismissed", "suspended", "restored"] },
        "reviewNote": { "type": "string", "maxLength": 300 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "reporterUid",
        "reporterUsername",
        "targetType",
        "targetId",
        "targetUid",
        "targetUsername",
        "contextId",
        "targetPreview",
        "reason",
        "details",
        "status",
        "reviewNote",
        "reviewedBy",
        "reviewedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ThankYouCard": {
