  "firestore": {
    "/usernames/{usernameLower}": {
      "schema": {
        "$ref": "#/entities/UsernameReservation"
      },
      "description": "Unique lowercase username claims mapped to owner UID."
    },
    "/users_public/{userId}": {
      "schema": {
        "$ref": "#/entities/UserPublic"
      },
      "description": "Public username identity for every signed-in user."
    },
    "/donors_public/{donorId}": {
      "schema": {
        "$ref": "#/entities/DonorPublic"
      },
      "description": "Publicly searchable donor entries with username, blood group, approximate coordinates, and chat preference only."
    },
    "/donors_private/{donorId}": {
      "schema": {
        "$ref": "#/entities/DonorPrivate"
      },
      "description": "Owner-only private donor PII (fullName, phone, email, lastDonationDate, exactLat, exactLng)."
    },
    "/emergency_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/EmergencyRequest"
      },
      "description": "Verified blood request records linked to an approved hospital without public contact numbers."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "In-app emergency alerts sent by the verifying hospital to eligible nearby donors."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "One-to-one chat conversations between two users."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Messages belonging to a one-to-one chat thread."
    },
    "/public_stats/{statId}": {
      "schema": {
        "$ref": "#/entities/PublicStats"
      },
      "description": "Aggregate public summary counters containing no personal data."
    },
    "/user_roles/{userId}": {
      "schema": {
        "$ref": "#/entities/UserRole"
      },
      "description": "User RBAC role assignments (donor, requester, hospital, admin) readable by owner or admin."
    },
    "/hospitals/{hospitalId}": {
      "schema": {
        "$ref": "#/entities/Hospital"
      },
      "description": "Registered hospitals and blood banks with pending/approved/rejected status and available units per blood group."
    },
    "/request_private_contacts/{requestId}": {
      "schema": {
        "$ref": "#/entities/RequestPrivateContact"
      },
      "description": "Private requester contact details accessible only to the requester and assigned hospital."
    },
    "/request_responses/{responseId}": {
      "schema": {
        "$ref": "#/entities/RequestResponse"
      },
      "description": "Donor responses and hospital verification/completion status per request and donor."
    },
    "/request_donor_contacts/{responseId}": {
      "schema": {
        "$ref": "#/entities/RequestDonorContact"
      },
      "description": "Private accepting donor contact accessible only to that donor and assigned hospital."
    },
    "/request_shared_contacts/{responseId}": {
      "schema": {
        "$ref": "#/entities/RequestSharedContact"
      },
      "description": "Scoped contact exchange created after hospital donor verification, readable only by that requester, donor, and hospital."
    },
    "/auth_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/AuthLog"
      },
      "description": "Admin-only signup/login security audit logs with keyed IP hash, random device ID, and 30-day retention expiration."
    },
    "/device_signup_windows/{deviceHash}": {
      "schema": {
        "$ref": "#/entities/SignupWindowCounter"
      },
      "description": "Opaque keyed-hash 24h signup counter per device ID (no PII)."
    },
    "/ip_signup_windows/{ipWindowHash}": {
      "schema": {
        "$ref": "#/entities/SignupWindowCounter"
      },
      "description": "Opaque keyed-hash 24h signup counter per IP address (no raw IP)."
    },
    "/account_moderation/{userId}": {
      "schema": {
        "$ref": "#/entities/AccountModeration"
      },
      "description": "Account flagging and admin moderation status (active, pending_review, suspended)."
    },
    "/user_rate_limits/{userId}": {
      "schema": {
        "$ref": "#/entities/UserRateLimit"
      },
      "description": "Per-user atomic sliding-window counters for emergency requests (3/24h) and chat messages (10/min)."
    },
    "/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/AbuseReport"
      },
      "description": "Abuse and spam reports submitted against users, emergency requests, or chat messages."
    },
    "/thank_you_cards/{cardId}": {
      "schema": {
        "$ref": "#/entities/ThankYouCard"
      },
      "description": "Donor-only Thank You cards generated when an assigned hospital marks a donation completed (no patient details)."
    },
    "/device_registrations/{deviceHash}": {
      "schema": {
        "$ref": "#/entities/DeviceRegistration"
      },
      "description": "Admin-only one-signup-per-device lock records supporting admin device resets and 30-day retention."
    },
    "/account_signups/{userId}": {
      "schema": {
        "$ref": "#/entities/AccountSignup"
      },
      "description": "Admin-only server-attested signup receipts preventing direct client signup bypasses."
    }
  }
}

