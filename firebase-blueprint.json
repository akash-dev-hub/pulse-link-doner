        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["windowStartMs", "uidHashes", "count24h", "updatedAt"]
    },
    "AccountModeration": {
      "title": "AccountModeration",
      "description": "Account flagging and moderation status (active, pending_review, suspended) managed by rate-limit detection and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "maxLength": 24 },
        "email": { "type": "string", "maxLength": 150 },
