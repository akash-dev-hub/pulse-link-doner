    "AuthLog": {
      "title": "AuthLog",
      "description": "Server-recorded signup and login event with keyed IP hash, random device ID, and 30-day retention expiration. Readable only by admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "maxLength": 24 },
        "email": { "type": "string", "maxLength": 150 },
        "eventType": { "type": "string", "enum": ["signup", "login"] },
        "ipHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "deviceId": { "type": "string", "minLength": 12, "maxLength": 64 },
        "consentAccepted": { "type": "boolean" },
        "deviceFlagged": { "type": "boolean" },
        "ipFlagged": { "type": "boolean" },
        "flagged": { "type": "boolean" },
        "flagReasons": { "type": "array", "items": { "type": "string" } },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
