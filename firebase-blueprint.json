{
  "entities": {
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Unique lowercase username reservation mapped to a single user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt", "updatedAt"]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public account identity holding only the user's unique username and UID (no real name, phone, or email).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt", "updatedAt"]
    },
    "DonorPublic": {
      "title": "DonorPublic",
      "description": "Publicly searchable donor profile containing ONLY username, blood group, approximate area, and in-app chat preference. Never stores real name, phone, email, exact coordinates, or raw donation dates.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "bloodGroup": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4
        },
        "countryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stateCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "stateName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "locality": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "pincode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "visibleInSearch": {
          "type": "boolean"
        },
        "eligibleAfterMs": {
          "type": "number"
        },
        "searchActiveAfterMs": {
          "type": "number"
        },
        "contactPreference": {
          "type": "string",
          "enum": ["chat", "hidden"]
        },
        "approxLat": {
          "type": "number"
        },
        "approxLng": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "bloodGroup",
        "countryCode",
        "countryName",
        "stateCode",
        "stateName",
        "city",
        "locality",
        "pincode",
        "visibleInSearch",
        "eligibleAfterMs",
        "searchActiveAfterMs",
        "contactPreference",
        "approxLat",
        "approxLng",
        "createdAt",
        "updatedAt"
      ]
    },
    "DonorPrivate": {
      "title": "DonorPrivate",
      "description": "Owner-only private donor data storing real name, phone, email, last donation date, and exact geolocation coordinates.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "contactPreference": {
          "type": "string",
          "enum": ["chat"]
        },
        "lastDonationDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "exactLat": {
          "type": "number"
        },
        "exactLng": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "phone",
        "email",
        "contactPreference",
        "lastDonationDate",
        "exactLat",
        "exactLng",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmergencyRequest": {
      "title": "EmergencyRequest",
      "description": "Hospital blood request posted to the emergency board (visible only to logged-in users).",
      "type": "object",
      "properties": {
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "bloodGroup": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "units": {
          "type": "integer"
        },
        "hospitalName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4
        },
        "countryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stateCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "stateName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "locality": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "pincode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        "hospitalLat": {
          "type": "number"
        },
        "hospitalLng": {
          "type": "number"
        },
        "contact": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["active", "fulfilled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "fulfilledAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "createdBy",
        "createdByName",
        "bloodGroup",
        "units",
        "hospitalName",
        "countryCode",
        "countryName",
        "stateCode",
        "stateName",
        "city",
        "locality",
        "pincode",
        "hospitalLat",
        "hospitalLng",
        "contact",
        "notes",
        "status",
        "createdAt",
        "updatedAt",
        "fulfilledAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification sent to eligible, visible donors matching blood group and city of an active emergency request.",
      "type": "object",
      "properties": {
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bloodGroup": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "units": {
          "type": "integer"
        },
        "hospitalName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "locality": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "stateName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "countryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contact": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "hospitalLat": {
          "type": "number"
        },
        "hospitalLng": {
          "type": "number"
        },
        "sameLocality": {
          "type": "boolean"
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "recipientId",
        "senderId",
        "requestId",
        "bloodGroup",
        "units",
        "hospitalName",
        "city",
        "locality",
        "stateName",
        "countryName",
        "contact",
        "hospitalLat",
        "hospitalLng",
        "sameLocality",
        "read",
        "createdAt"
      ]
    },
    "Chat": {
      "title": "Chat",
      "description": "One-to-one chat thread between two participants with unread counts and per-user block flags.",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array"
        },
        "p1Uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "p2Uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "p1Username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "p2Username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "p1Unread": {
          "type": "integer"
        },
        "p2Unread": {
          "type": "integer"
        },
        "blockedByP1": {
          "type": "boolean"
        },
        "blockedByP2": {
          "type": "boolean"
        },
        "lastMessageText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "lastMessageSenderId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "participantIds",
        "p1Uid",
        "p2Uid",
        "p1Username",
        "p2Username",
        "p1Unread",
        "p2Unread",
        "blockedByP1",
        "blockedByP2",
        "lastMessageText",
        "lastMessageSenderId",
        "lastMessageAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Single message inside a one-to-one chat thread.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "chatId",
        "participantIds",
        "senderId",
        "senderUsername",
        "text",
        "createdAt"
      ]
    },
    "PublicStats": {
      "title": "PublicStats",
      "description": "Publicly readable aggregate counts (registered donors, active requests, fulfilled requests) containing zero personal data.",
      "type": "object",
      "properties": {
        "registeredDonors": {
          "type": "integer"
        },
        "activeRequests": {
          "type": "integer"
        },
        "fulfilledRequests": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "registeredDonors",
        "activeRequests",
        "fulfilledRequests",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/usernames/{usernameLower}": {
      "schema": {
        "$ref": "#/entities/UsernameReservation"
      },
      "description": "Unique lowercase username claims mapped to owner UID."
    },
    "/users_public/{userId}": {
      "schema": {
        "$ref": "#/entities/UserPublic"
      },
      "description": "Public username identity for every signed-in user."
    },
    "/donors_public/{donorId}": {
      "schema": {
        "$ref": "#/entities/DonorPublic"
      },
      "description": "Publicly searchable donor entries with username, blood group, approximate coordinates, and chat preference only."
    },
    "/donors_private/{donorId}": {
      "schema": {
        "$ref": "#/entities/DonorPrivate"
      },
      "description": "Owner-only private donor PII (fullName, phone, email, lastDonationDate, exactLat, exactLng)."
    },
    "/emergency_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/EmergencyRequest"
      },
      "description": "Emergency blood requests posted for hospitals."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "In-app emergency alerts targeted to matching eligible visible donors."
    },
    "/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/Chat"
      },
      "description": "One-to-one chat conversations between two users."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Messages belonging to a one-to-one chat thread."
    },
    "/public_stats/{statId}": {
      "schema": {
        "$ref": "#/entities/PublicStats"
      },
      "description": "Aggregate public summary counters containing no personal data."
    }
  }
}
